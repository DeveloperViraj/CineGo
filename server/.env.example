NODE_ENV=production
PORT=3000
MONGO_URI=your MongoDB Atlas connection string
# MONGO_DB_NAME=test

CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
ADMIN_EMAILS=you@example.com          # comma-separated, auto-promoted to admin
OWNER_EMAIL=you@example.com           # comma-separated, can grant/revoke admins

TMDB_KEY=ey...                        # TMDB v4 read token (starts with "ey") or v3 api key

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...       # subscribe the webhook to: checkout.session.completed,
                                      # checkout.session.async_payment_succeeded, checkout.session.expired
# STRIPE_CURRENCY=usd                 # "inr" charges rupees directly
# INR_TO_USD_RATE=86
# SEAT_HOLD_MINUTES=10

EMAIL_USER=yourgmail@gmail.com        # Gmail SMTP (app password)
EMAIL_PASS=your_app_password
SENDER_EMAIL=yourgmail@gmail.com
# NEW_MOVIE_EMAILS=0                  # disable "new movie" emails for manual admin adds

INNGEST_EVENT_KEY=...                 # (INGEST_API_KEY still works)
INNGEST_SIGNING_KEY=signkey-prod-...

DEMO_CODE=demo123
FRONTEND_URL=https://your-frontend.vercel.app
# EXTRA_ORIGINS=https://preview.example.com,https://other.example.com

# ---------- Automatic movie & show schedule ----------
# Runs daily (Inngest cron 03:00 IST, Vercel cron, or the built-in timer on always-on hosts)
# and self-heals from the API if a run is missed. No manual updates needed.
CRON_SECRET=any-long-random-string     # required for /api/cron/sync-shows (Vercel sends it automatically)
# AUTO_SCHEDULE=1                      # set 0 to turn the automation off
# TMDB_REGION=IN                       # which country's "now playing" list to use
# AUTO_MOVIE_COUNT=12                  # how many now-playing movies to keep on sale
# AUTO_SCHEDULE_DAYS=14                # how many days ahead shows are bookable
# AUTO_SHOW_TIMES=09:30,12:15,15:00,18:00,21:00,22:45
# AUTO_SLOTS_PER_MOVIE=3
# AUTO_SHOW_PRICE=200                  # base ticket price (INR)
# AUTO_PRIME_SURCHARGE=50              # extra for shows from 17:00
# AUTO_WEEKEND_SURCHARGE=50            # extra on Fri/Sat/Sun
# SHOW_TZ_OFFSET=+05:30                # cinema timezone offset used for show times
# APP_TIMEZONE=Asia/Kolkata            # used to group dates and format emails
